generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// WORKFORCE
// ======================================================

model Collector {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  groupType String
  position  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bio                String?
  funFact            String?
  isEmployeeOfMonth  Boolean @default(false)
  photoUrl           String?
  preferredName      String?
  profileTitle       String?
  recognitionMessage String?
  showOnMeetTheBees  Boolean @default(true)

  hourlyEntries          HourlyOperationalEntry[]
  leadForagerReigns      LeadForagerReign[]
  monthlyLeadForagerWins MonthlyLeadForager[]
  emfEntries             QualityEmfEntry[]
  stickEntries           WorkerStickEntry[]

  roleAssignments       WorkerRoleAssignment[]
  performanceEntries    WorkerPerformanceEntry[]
  attendanceEntries     AttendanceEntry[]
  recognitionScores     MonthlyRecognitionScore[]
  employeeOfMonthScores EmployeeOfMonthScore[]

  scheduledShifts ScheduledShift[]

  @@index([active])
  @@index([position])
  @@index([showOnMeetTheBees])
  @@index([isEmployeeOfMonth])
}

// ======================================================
// WEEKLY STAFF SCHEDULE IMPORTS
// ======================================================

model ScheduleImport {
  id          Int      @id @default(autoincrement())
  fileName    String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  importedAt  DateTime @default(now())

  shifts ScheduledShift[]

  @@index([periodStart])
  @@index([periodEnd])
}

model ScheduledShift {
  id               Int      @id @default(autoincrement())
  scheduleImportId Int
  collectorId      Int?
  employeeName     String
  primaryJob       String?
  shiftDate        DateTime @db.Date
  startTime        String
  endTime          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scheduleImport ScheduleImport @relation(fields: [scheduleImportId], references: [id], onDelete: Cascade)
  collector      Collector?     @relation(fields: [collectorId], references: [id], onDelete: SetNull)

  @@unique([scheduleImportId, employeeName, shiftDate, startTime, endTime])
  @@index([shiftDate])
  @@index([collectorId])
  @@index([scheduleImportId])
}

// ======================================================
// WORKER ROLE ELIGIBILITY / CROSS-TRAINING
// ======================================================

model WorkerRoleAssignment {
  id          Int           @id @default(autoincrement())
  collectorId Int
  role        WorkforceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, role])
  @@index([collectorId])
  @@index([role])
}

// ======================================================
// PHLEBOTOMY STICK PERFORMANCE
// ======================================================

model WorkerStickEntry {
  id               Int      @id @default(autoincrement())
  collectorId      Int
  entryDate        DateTime
  totalSticks      Int      @default(0)
  successfulSticks Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, entryDate])
  @@index([entryDate])
  @@index([collectorId])
  @@index([collectorId, entryDate])
}

// ======================================================
// ROLE-BASED PERFORMANCE
// ======================================================

model WorkerPerformanceEntry {
  id              Int                   @id @default(autoincrement())
  collectorId     Int
  entryDate       DateTime
  role            WorkforceRole
  metric          PerformanceMetricType
  totalCount      Int                   @default(0)
  successfulCount Int?
  note            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, entryDate, role, metric])
  @@index([collectorId])
  @@index([entryDate])
  @@index([role, metric])
  @@index([collectorId, entryDate])
}

// ======================================================
// ROLE PRODUCTIVITY TARGETS
// ======================================================

model RolePerformanceTarget {
  id                 Int                   @id @default(autoincrement())
  role               WorkforceRole
  metric             PerformanceMetricType
  targetPerDay       Float
  accuracyApplicable Boolean               @default(false)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([role, metric])
  @@index([role])
  @@index([active])
}

// ======================================================
// QUALITY / EMF
// ======================================================

model QualityEmfEntry {
  id          Int      @id @default(autoincrement())
  collectorId Int
  entryDate   DateTime
  emfCount    Int      @default(1)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@index([collectorId])
  @@index([entryDate])
  @@index([collectorId, entryDate])
}

// ======================================================
// ATTENDANCE / RELIABILITY
// ======================================================

model AttendanceEntry {
  id          Int                 @id @default(autoincrement())
  collectorId Int
  entryDate   DateTime
  eventType   AttendanceEventType
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@index([collectorId])
  @@index([entryDate])
  @@index([eventType])
  @@index([collectorId, entryDate])
}

// ======================================================
// MONTHLY RECOGNITION / LEADERSHIP SCORE
// ======================================================

model MonthlyRecognitionScore {
  id          Int      @id @default(autoincrement())
  collectorId Int
  year        Int
  month       Int
  score       Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, year, month])
  @@index([year, month])
  @@index([collectorId])
}

// ======================================================
// EMPLOYEE OF THE MONTH SETTINGS
// ======================================================

model EmployeeOfMonthSettings {
  id Int @id @default(1)

  productivityWeight Float @default(35)
  accuracyWeight     Float @default(25)
  qualityWeight      Float @default(25)
  attendanceWeight   Float @default(10)
  recognitionWeight  Float @default(5)

  emfPenaltyPoints       Float @default(15)
  emfDisqualifyThreshold Int?

  latePenalty          Float @default(1)
  absentPenalty        Float @default(3)
  lateFromLunchPenalty Float @default(1)
  leftEarlyPenalty     Float @default(1.5)

  updatedAt DateTime @updatedAt
}

// ======================================================
// EMPLOYEE OF THE MONTH MONTHLY SCORES
// ======================================================

model EmployeeOfMonthScore {
  id          Int @id @default(autoincrement())
  collectorId Int
  year        Int
  month       Int

  productivityScore Float @default(0)
  accuracyScore     Float @default(0)
  qualityScore      Float @default(100)
  attendanceScore   Float @default(100)
  recognitionScore  Float @default(0)

  weightedScore Float @default(0)

  eligible         Boolean @default(true)
  ineligibleReason String?

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, year, month])
  @@index([year, month])
  @@index([collectorId])
  @@index([year, month, weightedScore])
}

// ======================================================
// LEAD FORAGER
// ======================================================

model LeadForagerReign {
  id                        Int       @id @default(1)
  collectorId               Int?
  benchmarkSuccessfulSticks Int       @default(0)
  crownedAt                 DateTime?
  updatedAt                 DateTime  @updatedAt

  collector Collector? @relation(fields: [collectorId], references: [id])

  @@index([collectorId])
}

model MonthlyLeadForager {
  id               Int      @id @default(autoincrement())
  year             Int
  month            Int
  collectorId      Int
  successfulSticks Int
  recordedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([year, month])
  @@index([collectorId])
  @@index([year, month])
}

// ======================================================
// CENTER PRODUCTION
// ======================================================

model DailyCenterProduction {
  id        Int      @id @default(autoincrement())
  entryDate DateTime @unique @db.Date
  liters    Float
  donors    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryDate])
}

// ======================================================
// HOURLY OPERATIONS
// ======================================================

model HourlyOperationalEntry {
  id                 Int      @id @default(autoincrement())
  collectorId        Int
  entryDate          DateTime
  operationalHour    Int
  successfulSticks   Int      @default(0)
  unsuccessfulSticks Int      @default(0)
  lostVolumeMl       Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@unique([collectorId, entryDate, operationalHour])
  @@index([entryDate])
  @@index([entryDate, operationalHour])
  @@index([collectorId])
}

// ======================================================
// HIVE SETTINGS
// ======================================================

model HiveSettings {
  id                         Int      @id @default(1)
  centerName                 String   @default("Riviera Beach 115")
  monthlyGoal                Float    @default(3500)
  weeksInPeriod              Float    @default(4.33)
  currentMonth               Int
  currentYear                Int
  updatedAt                  DateTime @updatedAt
  dashboardRotationSeconds   Int      @default(45)
  closingHour                Int      @default(19)
  openingHour                Int      @default(6)
  centerOperatingDaysPerWeek Int      @default(7)
  workerDaysPerWeek          Int      @default(5)
}

// ======================================================
// MONTHLY BUDGET
// ======================================================

model MonthlyBudget {
  id                   Int      @id @default(autoincrement())
  fiscalYear           Int
  month                Int
  budgetLiters         Float
  originalBudgetLiters Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  budgetDonors         Int      @default(0)
  originalBudgetDonors Int      @default(0)

  @@unique([fiscalYear, month])
  @@index([fiscalYear])
}

// ======================================================
// DASHBOARD METRICS
// ======================================================

model DashboardMetric {
  id            Int          @id @default(autoincrement())
  key           String       @unique
  displayName   String
  description   String?
  unit          String?
  decimalPlaces Int          @default(2)
  publicSource  MetricSource @default(CSL)

  // Public Executive Intelligence visibility
  isVisible Boolean @default(true)

  displayOrder Int @default(0)

  // ------------------------------------------
  // EXECUTIVE COMPARATIVE INTELLIGENCE
  // ------------------------------------------

  comparisonEnabled Boolean @default(false)

  // HIGHER = higher value is favorable
  // LOWER  = lower value is favorable
  // NEUTRAL = direction is informational only
  improvementDirection String @default("HIGHER")

  // Used when HIVE can resolve the value itself.
  // Null means MetricReading supplies the value.
  dataSourceKey String?

  // Built-ins stay in the metric library even
  // when temporarily hidden.
  isBuiltIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings MetricReading[]

  @@index([isVisible, displayOrder])
  @@index([comparisonEnabled, isVisible])
}

model MetricReading {
  id         Int          @id @default(autoincrement())
  metricId   Int
  source     MetricSource
  value      Float
  recordedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  metric DashboardMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, source, recordedAt])
  @@index([recordedAt])
}

// ======================================================
// ENUMS
// ======================================================

enum WorkforceRole {
  MANAGEMENT
  PHLEBOTOMIST
  GROUP_LEAD
  PROCESSOR
  RECEPTION_TECH
  MSA
  DST
  OTHER
}

enum PerformanceMetricType {
  STICKS
  RESTICKS
  DISCONNECTS
  SETUPS
  PHYSICALS
  INTERVIEWS
  PROCESSED
  SEPARATIONS
  SOLUTIONS_SPIKED
  OTHER
}

enum AttendanceEventType {
  LATE
  ABSENT
  LATE_FROM_LUNCH
  LEFT_EARLY
}

enum MetricSource {
  CSL
  HIVE
  MANUAL
}
